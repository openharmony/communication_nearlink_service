# ==================== 条件编译（与 services/service/BUILD.gn 保持一致） ====================

if (nearlink_service_kia_enable) {
  shared_service_external_deps += [ "security_guard:libsg_collect_sdk" ]
  shared_service_defines += [ "NEARLINK_KIA_ENABLE" ]
}

if (nearlink_service_edm_enable) {
  shared_service_source += [
    "$SERVICE_TDD_DIR/src/common/SleEdmManager.cpp",
  ]
  shared_service_defines += [ "NEARLINK_EDM_ENABLE" ]
}

if (nearlink_service_host_dynamic_running) {
  shared_service_external_deps += [ "hdf_core:libhdi" ]
  shared_service_defines += [ "NEARLINK_HOST_DYNAMIC_RUNING" ]
}

if (nearlink_service_no_pairing_dialog) {
  shared_service_defines += [ "NO_PAIRING_DIALOG" ]
}

if (nearlink_service_sync_ap_to_mcu) {
  shared_service_defines += [ "NEARLINK_SYNC_AP_TO_MCU" ]
}

if (nearlink_service_min_conn_interval != 0) {
  shared_service_defines += [ "MIN_CONN_INTERVAL=${nearlink_service_min_conn_interval}" ]
}

if (nearlink_deps_audio_exist) {
  shared_service_source += [
    "$SERVICE_TDD_DIR/src/mcp/McpServerService.cpp",
    "$SERVICE_TDD_DIR/src/asc/ASCService.cpp",
    "$SERVICE_TDD_DIR/src/asc/QosM.cpp",
