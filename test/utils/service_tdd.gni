    "$SERVICE_TDD_DIR/src/vcp/VcpStackAdapter.cpp",
    "$SERVICE_TDD_DIR/src/mic/MicService.cpp",
    "$SERVICE_TDD_DIR/src/mic/MicClientStackAdapter.cpp",
    "$SERVICE_TDD_DIR/src/audio/SleAudioFrameworkAdapter.cpp",
  ]
  shared_service_external_deps += [
    "audio_framework:audio_policy_manager",
    "audio_framework:audio_engine_manager",
    "audio_framework:audio_foundation",
  ]
}

if (nearlink_deps_telephony_exist) {
  shared_service_source += [
    "$SERVICE_TDD_DIR/src/ccp/CcpService.cpp",
    "$SERVICE_TDD_DIR/src/ccp/CcpStackAdapter.cpp",
    "$SERVICE_TDD_DIR/src/ccp/CcpSystemInterface.cpp",
    "$SERVICE_TDD_DIR/src/vas/VasService.cpp",
    "$SERVICE_TDD_DIR/src/vas/VasStackAdapter.cpp",
  ]
  shared_service_external_deps += [
    "call_manager:tel_call_manager_api",
    "core_service:tel_core_service_api",
    "state_registry:tel_state_registry_api",
  ]
}

if (nearlink_deps_device_manager_exist) {
  shared_service_external_deps += [ "device_manager:devicemanagersdk" ]
  shared_service_defines += [ "DEVICE_MANAGER" ]
}

if (nearlink_deps_resource_schedule_service_exist && nearlink_service_rss_background_task) {
  shared_service_external_deps += [ "resource_schedule_service:ressched_client" ]
  shared_service_defines += [ "RES_SCHED_SUPPORT" ]
}

if (factory == true) {
  shared_service_defines += [ "CONFIG_FACTORY_VERSION" ]
}

shared_service_defines += product_defines
