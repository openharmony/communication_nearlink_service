import("//build/test.gni")
import("../../../../../nearlink_config.gni")
import("../../../../../test/utils/test_utils.gni")

config("ssap_descriptor_framework_test_config") {
  visibility = [ ":*" ]

  include_dirs = [
    "$NEARLINK_ROOT/frameworks/native/include",
    "$NEARLINK_ROOT/frameworks/native",
    "$NEARLINK_ROOT/interfaces/inner_api/include",
    "$NEARLINK_ROOT/interfaces/inner_api/include/base",
    "$NEARLINK_ROOT/interfaces/def",
    "$NEARLINK_ROOT/utils/include",
    "$NEARLINK_ROOT/test/unittest/frameworks_test/native_test",
  ]

  defines = [
    "LOG_TAG = \"nearlink_test\"",
    "LOG_DOMAIN = 0xD000151",
  ]
  cflags_cc = [ "-fexceptions" ]
  cflags = [ "--coverage" ]
  ldflags = [ "--coverage" ]
}

test_out_path = "nearlink_service/nearlink_service"

ohos_unittest("nl_ssap_descriptor_framework_test") {
  module_out_path = test_out_path

  branch_protector_ret = "pac_ret"  # Enable PAC CFI
  sanitize = {
    cfi = true                             # Enable/disable control flow integrity detection
    boundary_sanitize = true               # Enable boundary san detection
    cfi_cross_dso = true                   # Cross-SO CFI Checks
    integer_overflow = true                # Enable integer overflow detection
    ubsan = true                           # Enable some Ubsan options
    debug = false
  }

  sources = [
    "$NEARLINK_ROOT/test/unittest/frameworks_test/native_test/ssap_descriptor_framework_test/nearlink_ssap_descriptor_framework_test.cpp",
  ]

  configs = [
    ":ssap_descriptor_framework_test_config",
    "${nearlink_test_utils_path}:test_utils_config",
  ]

  deps = [
    "$NEARLINK_ROOT/frameworks/native:nearlink_framework",
    "$NEARLINK_ROOT/frameworks/native/base:nearlink_framework_base",
    "$NEARLINK_ROOT/utils:nearlink_utils",
    "${nearlink_test_utils_path}:test_utils_static",
  ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
    "init:libbegetutil",
  ]

  part_name = "nearlink"
  subsystem_name = "communication"
}

group("nl_ssap_descriptor_framework_unittest") {
  testonly = true
  deps = [
    ":nl_ssap_descriptor_framework_test",
  ]
}
