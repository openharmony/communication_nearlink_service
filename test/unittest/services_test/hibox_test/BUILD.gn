import("//build/test.gni")
import("../../../../nearlink_config.gni")

NL_HIBOX_TEST_DIR = "$NEARLINK_ROOT/test/unittest/services_test/hibox_test"

config("hibox_test_config") {
  visibility = [ ":*" ]

  include_dirs = [
    "$NEARLINK_ROOT/services/hibox/include",
    "$NEARLINK_ROOT/utils/include",
  ]

  defines = [
    "LOG_DOMAIN = 0xD000151",
  ]
  cflags = [ "--coverage" ]
  cflags_cc = [
    "-fexceptions",
    "--coverage",
  ]
  ldflags = [ "--coverage" ]
}

test_out_path = "nearlink_service/nearlink_service"

ohos_unittest("nl_hibox_test") {
  module_out_path = test_out_path

  branch_protector_ret = "pac_ret"  # Enable PAC CFI
  sanitize = {
    cfi = true                             # Enable/disable control flow integrity detection
    boundary_sanitize = true               # Enable boundary san detection
    cfi_cross_dso = true                   # Cross-DSO CFI Checks
    integer_overflow = true                # Enable integer overflow detection
    ubsan = true                           # Enable some Ubsan options
    debug = false
  }

  sources = [
    "$NL_HIBOX_TEST_DIR/hibox_tlv_parse_test.cpp",
    "$NEARLINK_ROOT/services/hibox/src/hibox_audio.c",
    "$NEARLINK_ROOT/services/hibox/src/hibox_dts.c",
    "$NEARLINK_ROOT/services/hibox/src/hibox_local.c",
  ]

  configs = [ ":hibox_test_config" ]

  external_deps = [
    "bounds_checking_function:libsec_shared",
    "c_utils:utils",
    "googletest:gtest_main",
    "hilog:libhilog",
  ]

  part_name = "nearlink_service"
  subsystem_name = "communication"
}

group("nl_hibox_unittest") {
  testonly = true
  deps = [
    ":nl_hibox_test",
  ]
}
