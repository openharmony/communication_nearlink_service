import("//build/test.gni")
import("../../../../../nearlink_config.gni")

NL_DFT_FILTER_TEST_DIR = "$NEARLINK_ROOT/test/unittest/services_test/dft_test/dft_report_filter_test"

config("dft_report_filter_test_config") {
  visibility = [ ":*" ]

  include_dirs = [
    "$NEARLINK_ROOT/services/common/include",
    "$NEARLINK_ROOT/services/dft/include",
    "$NEARLINK_ROOT/test/unittest/services_test/dft_test/dft_report_filter_test",
  ]

  defines = [
    "LOG_TAG = \"nearlink_test\"",
    "LOG_DOMAIN = 0xD000151",
  ]
  cflags_cc = [ "--coverage" ]
  ldflags = [ "--coverage" ]
}

unit_test_deps = [
  "$NEARLINK_ROOT/utils:nearlink_utils",
  "$NEARLINK_ROOT/services/dft:nearlink_dft_manager",
]

unit_test_external_deps = [
  "ffrt:libffrt",
  "c_utils:utils",
  "hilog:libhilog",
  "ipc:ipc_core",
  "safwk:system_ability_fwk",
  "samgr:samgr_proxy",
  "huks:libhukssdk",
  "preferences:native_preferences",
  "access_token:libaccesstoken_sdk",
  "access_token:libtokenid_sdk",
  "ability_base:want",
  "common_event_service:cesfwk_innerkits",
  "hisysevent:libhisysevent",
  "hisysevent:libhisyseventmanager",
]

test_out_path = "nearlink_service/nearlink_service"

ohos_unittest("nearlink_dft_report_filter_test") {
  module_out_path = test_out_path

  branch_protector_ret = "pac_ret"
  sanitize = {
    cfi = true
    boundary_sanitize = true
    cfi_cross_dso = true
    integer_overflow = true
    ubsan = true
    debug = false
  }

  sources = [
    "$NL_DFT_FILTER_TEST_DIR/nearlink_dft_manager_c_mock.cpp",
    "$NL_DFT_FILTER_TEST_DIR/nearlink_dft_report_filter_test.cpp",
  ]

  configs = [ ":dft_report_filter_test_config" ]

  deps = unit_test_deps

  external_deps = unit_test_external_deps

  part_name = "nearlink_service"
  subsystem_name = "communication"
}

group("dft_report_filter_test") {
  testonly = true
  deps = [
    ":nearlink_dft_report_filter_test",
  ]
}
