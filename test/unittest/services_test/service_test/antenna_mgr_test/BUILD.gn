import("//build/test.gni")
import("../../../../../nearlink_config.gni")

config("nl_antenna_mgr_unit_test_config") {
  visibility = [ ":*" ]

  include_dirs = [
    "$NEARLINK_ROOT/services/service/src/common",
    "$NEARLINK_ROOT/services/common/include",
    "$NEARLINK_ROOT/services/service/include",
    "$NEARLINK_ROOT/services/stack/include/ext",
    "$NEARLINK_ROOT/services/stack/src/sdf/interface",
    "$NEARLINK_ROOT/services/stack/src/sdf/utils/include",
    "$NEARLINK_ROOT/services/stack/src/sdf/bsl/dsl/include",
    "$NEARLINK_ROOT/interfaces/def",
    "$NEARLINK_ROOT/interfaces/inner_api/include",
    "$NEARLINK_ROOT/utils/include",
  ]

  defines = [
    "LOG_TAG = \"nearlink_test\"",
    "LOG_DOMAIN = 0xD000151",
  ]
  cflags_cc = [ "-fexceptions" ]
  cflags = [
    "--coverage",
    "-Wno-format",
  ]
  ldflags = [ "--coverage" ]
}

test_out_path = "nearlink_service/nearlink_service"

ohos_unittest("nl_antenna_mgr_test") {
  module_out_path = test_out_path

  branch_protector_ret = "pac_ret"  # Enable PAC CFI
  sanitize = {
    cfi = true                             # Enable/disable control flow integrity detection
    boundary_sanitize = true               # Enable boundary san detection
    cfi_cross_dso = true                   # Cross-DSO CFI Checks
    integer_overflow = true                # Enable integer overflow detection
    ubsan = true                           # Enable some Ubsan options
    debug = false
  }

  sources = [
    "sle_frame4_antenna_mgr_matrix_test.cpp",
    "mock_ServiceManagerPluginInterface.cpp",
    "$NEARLINK_ROOT/services/service/src/common/SleFrame4AntennaMgr.cpp",
    "$NEARLINK_ROOT/services/common/src/ThreadUtil.cpp",
  ]

  configs = [ ":nl_antenna_mgr_unit_test_config" ]

  external_deps = [
    "googletest:gtest_main",
    "hilog:libhilog",
    "c_utils:utils",
    "ffrt:libffrt",
    "bounds_checking_function:libsec_shared",
  ]

  part_name = "nearlink"
  subsystem_name = "communication"
}

group("nl_antenna_mgr_unittest") {
  testonly = true
  deps = [
    ":nl_antenna_mgr_test",
  ]
}
