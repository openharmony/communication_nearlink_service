import("//build/test.gni")
import("../../../../../nearlink_config.gni")

config("nl_hibox_unit_test_config") {
  visibility = [ ":*" ]

  include_dirs = [
    "$NEARLINK_ROOT/services/hibox/include",
    "$NEARLINK_ROOT/utils/include",
  ]

  defines = [
    "LOG_TAG = \"nearlink_test\"",
    "LOG_DOMAIN = 0xD000151",
  ]

  cflags = [ "--coverage" ]
  ldflags = [ "--coverage" ]
}

test_out_path = "nearlink_service/nearlink_service"

ohos_unittest("nl_hibox_local_test") {
  module_out_path = test_out_path

  branch_protector_ret = "pac_ret"
  sanitize = {
    cfi = true
    boundary_sanitize = true
    cfi_cross_dso = true
    integer_overflow = true
    ubsan = true
    debug = true
  }

  sources = [
    "$NEARLINK_ROOT/services/hibox/src/hibox_audio.c",
    "$NEARLINK_ROOT/services/hibox/src/hibox_dts.c",
    "$NEARLINK_ROOT/services/hibox/src/hibox_local.c",
    "nl_hibox_test.cpp",
  ]

  configs = [ ":nl_hibox_unit_test_config" ]

  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
    "bounds_checking_function:libsec_shared",
    "googletest:gtest_main",
  ]

  part_name = "nearlink"
  subsystem_name = "communication"
}

group("nl_hibox_local_unittest") {
  testonly = true
  deps = [
    ":nl_hibox_local_test",
  ]
}
