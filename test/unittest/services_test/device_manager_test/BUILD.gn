import("//build/test.gni")
import("../../../../nearlink_config.gni")

NL_DM_TEST_DIR = "$NEARLINK_ROOT/test/unittest/services_test/device_manager_test"

config("nl_device_manager_test_config") {
  visibility = [ ":*" ]

  include_dirs = [
    "$NEARLINK_ROOT/services/device_manager/include",
    "$NEARLINK_ROOT/services/common/include",
    "$NEARLINK_ROOT/utils/include",
    "$NEARLINK_ROOT/interfaces/def",
    "$NEARLINK_ROOT/interfaces/inner_api/include",
    "$NEARLINK_ROOT/services/stack/src/sdf/interface",
  ]

  defines = [
    "LOG_TAG = \"nearlink_test\"",
    "LOG_DOMAIN = 0xD000151",
    "private = public",
    "protected = public",
  ]

  cflags = [ "--coverage" ]
  cflags_cc = [
    "-fexceptions",
    "--coverage",
  ]
  ldflags = [ "--coverage" ]
}

test_out_path = "nearlink_service/nearlink_service"

ohos_unittest("nl_device_manager_test") {
  module_out_path = test_out_path

  branch_protector_ret = "pac_ret"  # Enable PAC CFI
  sanitize = {
    cfi = true                             # Enable/disable control flow integrity detection
    boundary_sanitize = true               # Enable boundary san detection
    cfi_cross_dso = true                   # Cross-DSO CFI Checks
    integer_overflow = true                # Enable integer overflow detection
    ubsan = true                           # Enable some Ubsan options
    debug = false
  }

  sources = [
    "$NL_DM_TEST_DIR/adapter_device_config_test.cpp",
    "$NL_DM_TEST_DIR/nearlink_device_manager_test.cpp",
    "$NL_DM_TEST_DIR/sle_coexist_manager_test.cpp",
    "$NL_DM_TEST_DIR/sle_remote_device_manager_test.cpp",
    "$NL_DM_TEST_DIR/sle_utils_test.cpp",
    "$NL_DM_TEST_DIR/xml_parse_test.cpp",
    "$NEARLINK_ROOT/services/device_manager/src/AdapterDeviceConfig.cpp",
    "$NEARLINK_ROOT/services/device_manager/src/SleCoexistManager.cpp",
    "$NEARLINK_ROOT/services/device_manager/src/SleConfig.cpp",
    "$NEARLINK_ROOT/services/device_manager/src/SleHuksTool.cpp",
    "$NEARLINK_ROOT/services/device_manager/src/SleRemoteDeviceManager.cpp",
    "$NEARLINK_ROOT/services/device_manager/src/SleUtils.cpp",
    "$NEARLINK_ROOT/services/device_manager/src/nearlink_device_manager.cpp",
    "$NEARLINK_ROOT/services/device_manager/src/xml_parse.cpp",
  ]

  configs = [ ":nl_device_manager_test_config" ]

  deps = [
    "$NEARLINK_ROOT/services/common:nearlink_service_common",
    "$NEARLINK_ROOT/utils:nearlink_utils",
  ]

  external_deps = [
    "bounds_checking_function:libsec_shared",
    "common_event_service:cesfwk_innerkits",
    "c_utils:utils",
    "googletest:gtest_main",
    "hilog:libhilog",
    "hisysevent:libhisysevent",
    "hisysevent:libhisyseventmanager",
    "huks:libhukssdk",
    "libxml2:libxml2",
  ]

  part_name = "nearlink_service"
  subsystem_name = "communication"
}

group("nl_device_manager_unittest") {
  testonly = true
  deps = [
    ":nl_device_manager_test",
  ]
}
