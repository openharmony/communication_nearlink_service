#####################hydra-fuzz###################
import("//build/config/features.gni")
import("//build/test.gni")
import("../../../nearlink_config.gni")
import("../../utils/test_utils.gni")

##############################fuzztest##########################################
ohos_fuzztest("VcpServiceFuzzTest") {
  module_out_path = module_output_path
  fuzz_config_file = "$NEARLINK_ROOT/test/fuzztest/vcpservice_fuzzer"

  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]

  branch_protector_ret = "pac_ret"
  sanitize = {
    cfi = true                             # Enable/disable control flow integrity detection
    cfi_cross_dso = true                   # Cross-SO CFI Checks
    debug = true
  }

  include_dirs = [
    "$NEARLINK_ROOT/utils/include",
    "$NEARLINK_ROOT/frameworks/inner/include",
    "$NEARLINK_ROOT/interfaces/inner_api/include",
    "$NEARLINK_ROOT/services/ipc/include",
    "$NEARLINK_ROOT/services/server/include",
    "$NEARLINK_ROOT/services/service/src/permission",
    "$NEARLINK_ROOT/services/service/src/vcp",
    "$NEARLINK_ROOT/services/stack/src/sdf/bsl/dsl/include",
    "$NEARLINK_ROOT/services/stack/src/sdf/utils/include",
    "$NEARLINK_ROOT/services/service/src/common",
  ]

  # 弱耦合部件条件编译：audio 部件存在时直调 VcpService/VcpStackAdapter
  defines = []
  if (nearlink_deps_audio_exist) {
    defines += [ "NEARLINK_FUZZ_AUDIO_PARTS" ]
    include_dirs += [
      "$NEARLINK_ROOT/services/service/src/vcp",
      "$NEARLINK_ROOT/services/stack/src/cp/bal/audioctl/mctl/include",
      "$NEARLINK_ROOT/services/stack/src/cp/nlstkfwk/public/include",
    "$NEARLINK_ROOT/services/stack/src/sdf/utils/include",
      ]
  }

  # telephony 部件存在时直调 CcpService/CcpStackAdapter（call_manager 头文件编译必需）
  if (nearlink_deps_telephony_exist) {
    defines += [ "NEARLINK_FUZZ_TELEPHONY_PARTS" ]
    include_dirs += [
      "$NEARLINK_ROOT/services/service/src/ccp",
      "$NEARLINK_ROOT/services/stack/src/cp/bal/audioctl/cctl/include",
      "$NEARLINK_ROOT/services/stack/src/cp/nlstkfwk/public/include",
    "$NEARLINK_ROOT/services/stack/src/sdf/utils/include",
      ]
  }

  configs = [ "${nearlink_test_utils_path}:test_utils_config" ]

  sources = [ "vcpservice_fuzzer.cpp" ]
  sources += [ "$MOCK_HOST_SERVER_FILE/mock_nearlink_host_server.cpp" ]

  deps = [
    "$NEARLINK_ROOT/frameworks/native:nearlink_framework",
    "$NEARLINK_ROOT/utils:nearlink_utils",
    "$NEARLINK_ROOT/ipc_parcel:nearlink_ipc_parcel",
    "$NEARLINK_ROOT/services/ipc:nl_service_ipc",
    "$NEARLINK_ROOT/services/server:nearlink_server_static",
    "$NEARLINK_ROOT/services/common:nearlink_service_common",
    "$NEARLINK_ROOT/services/device_manager:nearlink_device_manager",
    "$NEARLINK_ROOT/services/service:nearlink_service_impl_static",
    "${nearlink_test_utils_path}:test_utils_static",
    "${nearlink_fuzztest_utils_path}:fuzztest_utils_static",
  ]

  external_deps = [
    "bounds_checking_function:libsec_shared",
    "hilog:libhilog",
    "ipc:ipc_single",
    "access_token:libaccesstoken_sdk",
    "access_token:libtokenid_sdk",
    "ffrt:libffrt",
    "common_event_service:cesfwk_innerkits",
    "safwk:system_ability_fwk",
    "samgr:samgr_proxy",
  ]

  if (nearlink_deps_telephony_exist) {
    external_deps += [ "call_manager:tel_call_manager_api" ]
  }
}

###############################################################################
group("fuzztest") {
  testonly = true
  deps = []
  deps += [
    # deps file
    ":VcpServiceFuzzTest",
  ]
}
###############################################################################
