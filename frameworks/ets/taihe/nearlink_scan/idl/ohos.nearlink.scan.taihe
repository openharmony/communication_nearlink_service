from ohos.nearlink.constant use DeviceClass;

@!namespace("@ohos.nearlink.scan", "scan")
@!sts_inject("""
static { loadLibrary("nearlinkScanTaihe_native.z") }
""")

@promise function StartScan(filters: Filters, options: Optional<ScanOptions>): void;
@promise function StopScan(): void;

function OnDeviceFound(callback: (data: Array<ScanResults>) => void): void;
function OffDeviceFound(callback: Optional<(data: Array<ScanResults>) => void>): void;

union Filters {
    @null type_null;
    type_Filters: Array<ScanFilters>;
}

struct ScanResults {
    address: String;
    rssi: i32;
    data: @arraybuffer Array<u8>;
    deviceName: String;
    isConnectable: bool;
    deviceClass: Optional<DeviceClass>;
}

struct ScanFilters {
    address: Optional<String>;
    deviceName: Optional<String>;
    manufacturerId: Optional<i32>;
    manufacturerData: Optional<@arraybuffer Array<u8>>;
    manufacturerDataMask: Optional<@arraybuffer Array<u8>>;
    rssi: Optional<i32>;
}

struct ScanOptions {
    scanMode: Optional<ScanMode>;
    duration: Optional<i32>;
}

enum ScanMode: i32 {
    SCAN_MODE_LOW_POWER = 0,
    SCAN_MODE_BALANCED = 1,
    SCAN_MODE_LOW_LATENCY = 2
}