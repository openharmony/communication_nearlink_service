from ohos.nearlink.constant use ConnectionState;

@!namespace("@ohos.nearlink.ssap", "ssap")
@!sts_inject("""
static { loadLibrary("nearlinkSsapTaihe_native.z") }
""")

function CreateClient(address: String): Client;
function CreateServer(): Server;

interface Client {
    @promise Connect(): void;
    @promise Disconnect(): void;
    Close(): void;
    @promise GetServices(): Array<Service>;

    @rename("readProperty")
    ReadProperty(property: Property): @sts_type("Promise<Property>") Opaque;

    @rename("writeProperty")
    WriteProperty(property: Property, writeType: PropertyWriteType): @sts_type("Promise<void>") Opaque;

    @rename("readDescriptor")
    ReadDescriptor(descriptor: PropertyDescriptor): @sts_type("Promise<PropertyDescriptor>") Opaque;

    @rename("writeDescriptor")
    WriteDescriptor(descriptor: PropertyDescriptor): @sts_type("Promise<void>") Opaque;

    @rename("setPropertyNotification")
    SetPropertyNotification(property: Property, enable: bool): @sts_type("Promise<void>") Opaque;

    @rename("setPropertyIndication")
    SetPropertyIndication(property: Property, enable: bool): @sts_type("Promise<void>") Opaque;

    @promise RequestMtuSize(mtu: i32): void;

    @rename("callMethod")
    CallMethod(method: Method): @sts_type("Promise<Method>") Opaque;

    OnPropertyChange(callback: (data: Property) => void): void;
    OffPropertyChange(callback: Optional<(data: Property) => void>): void;
    OnEventNotify(callback: (data: Event) => void): void;
    OffEventNotify(callback: Optional<(data: Event) => void>): void;
    OnConnectionStateChange(callback: (data: ConnectionChangeState) => void): void;
    OffConnectionStateChange(callback: Optional<(data: ConnectionChangeState) => void>): void;
    OnMtuChange(callback: (data: i32) => void): void;
    OffMtuChange(callback: Optional<(data: i32) => void>): void;
}

interface Server {
    AddService(service: Service): void;
    RemoveService(serviceUuid: String): void;
    Close(): void;
    @promise NotifyPropertyChanged(address: String, property: Property): void;
    SendResponse(response: ServerResponse): void;
    OnConnectionStateChange(callback: (data: ConnectionChangeState) => void): void;
    OffConnectionStateChange(callback: Optional<(data: ConnectionChangeState) => void>): void;
    OnPropertyRead(callback: (data: PropertyReadRequest) => void): void;
    OffPropertyRead(callback: Optional<(data: PropertyReadRequest) => void>): void;
    OnPropertyWrite(callback: (data: PropertyWriteRequest) => void): void;
    OffPropertyWrite(callback: Optional<(data: PropertyWriteRequest) => void>): void;
    OnMtuChange(callback: (data: i32) => void): void;
    OffMtuChange(callback: Optional<(data: i32) => void>): void;
}

struct Service {
    serviceUuid: String;
    properties: Array<Property>;
    methods: Optional<Array<Method>>;
    events: Optional<Array<Event>>;
}

struct Property {
    serviceUuid: String;
    propertyUuid: String;
    value: @arraybuffer Array<u8>;
    descriptors: Optional<Array<PropertyDescriptor>>;
    operation: Optional<i32>;
}

struct Method {
    serviceUuid: String;
    methodUuid: String;
    parameter: Optional<@arraybuffer Array<u8>>;
    result: Optional<@arraybuffer Array<u8>>;
}

struct Event {
    serviceUuid: String;
    eventUuid: String;
    parameter: Optional<@arraybuffer Array<u8>>;
}

struct PropertyDescriptor {
    serviceUuid: String;
    propertyUuid: String;
    value: @arraybuffer Array<u8>;
    descriptorType: PropertyDescriptorType;
    isWriteable: Optional<bool>;
}

struct PropertyReadRequest {
    address: String;
    serviceUuid: String;
    propertyUuid: String;
    requestId: i32;
}

struct PropertyWriteRequest {
    address: String;
    serviceUuid: String;
    propertyUuid: String;
    value: @arraybuffer Array<u8>;
    requestId: i32;
    writeType: PropertyWriteType;
}

struct ServerResponse {
    address: String;
    requestId: i32;
    value: @arraybuffer Array<u8>;
}

struct ConnectionChangeState {
    address: String;
    state: ConnectionState;
}

enum PropertyDescriptorType: i32 {
    PROPERTY = 1,
    CLIENT_PROPERTY_CONFIG = 2,
    SERVER_PROPERTY_CONFIG = 3,
    PROPERTY_FORMAT = 4,
    TYPE_VENDOR = 255
}

enum Operation: i32 {
    READABLE = 0x01,
    WRITE_NO_RESPONSE = 0x02,
    WRITE_WITH_RESPONSE = 0x04,
    NOTIFY = 0x08
}


enum PropertyWriteType: i32 {
    WRITE = 1,
    WRITE_NO_RESPONSE = 2
}