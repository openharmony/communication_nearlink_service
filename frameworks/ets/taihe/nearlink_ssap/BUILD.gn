import("//build/config/components/ets_frontend/ets2abc_config.gni")
import("//build/ohos.gni")
import("//build/ohos/taihe_idl/taihe.gni")

SLE_PART_DIR = "../../../../"

copy_taihe_idl("nearlink_ssap_taihe") {
  sources = [
    "idl/ohos.nearlink.ssap.taihe"
  ]
  deps = [
    "$SLE_PART_DIR/frameworks/ets/taihe/nearlink_constant:nearlink_constant_taihe"
  ]
}

subsystem_name = "communication"
part_name = "nearlink_service"
taihe_generated_file_path_ssap = "$taihe_file_path/out/$subsystem_name/$part_name/ssap"

ohos_taihe("run_taihe") {
  taihe_generated_file_path = "$taihe_generated_file_path_ssap"
  deps = [ ":nearlink_ssap_taihe" ]
  outputs = [
    "$taihe_generated_file_path_ssap/src/ohos.nearlink.ssap.ani.cpp",
    "$taihe_generated_file_path_ssap/src/ohos.nearlink.ssap.abi.c",
  ]
}

taihe_shared_library("nearlinkSsapTaihe_native") {
  branch_protector_ret = "pac_ret"  # Enable PAC CFI
  shlib_type = "ani"
  taihe_generated_file_path = "$taihe_generated_file_path_ssap"
  part_name = "$part_name"
  subsystem_name = "$subsystem_name"
  sources = get_target_outputs(":run_taihe")
  include_dirs = [
    "include",
    "src",
    "$SLE_PART_DIR/utils/include",
    "$SLE_PART_DIR/interfaces/inner_api/include",
    "$SLE_PART_DIR/frameworks/ets/taihe/common",
  ]
  sources += [
    "src/ani_constructor.cpp",
    "src/ani_nearlink_ssap_client.cpp",
    "src/ani_nearlink_ssap_server.cpp",
    "src/ani_nearlink_ssap_utils.cpp",
    "src/ani_nearlink_ssap_client_callback.cpp",
    "src/ani_nearlink_ssap_server_callback.cpp",
    "src/ohos.nearlink.ssap.impl.cpp",
    "$SLE_PART_DIR/frameworks/ets/taihe/common/ani_nearlink_error.cpp",
    "$SLE_PART_DIR/frameworks/ets/taihe/common/ani_nearlink_utils.cpp",
    "$SLE_PART_DIR/frameworks/ets/taihe/common/taihe_async_callback.cpp",
    "$SLE_PART_DIR/frameworks/ets/taihe/common/taihe_async_work.cpp",
    "$SLE_PART_DIR/frameworks/ets/taihe/common/taihe_native_object.cpp",
    "$SLE_PART_DIR/frameworks/ets/taihe/common/taihe_timer.cpp"
  ]
  deps = [
    ":run_taihe",
    "$SLE_PART_DIR/utils:nearlink_utils",
    "$SLE_PART_DIR/frameworks/native:nearlink_framework",
  ]
  external_deps = [
    "c_utils:utils",
    "hilog:libhilog",
  ]
  sanitize = {
    cfi = true                             # Enable/disable control flow integrity detection
    cfi_vcall_icall_only = true            # CFI optimization, limit CFI check scope
    boundary_sanitize = true               # Enable boundary san detection
    cfi_cross_dso = true                   # Cross-SO CFI Checks
    integer_overflow = true                # Enable integer overflow detection
    ubsan = true                           # Enable some Ubsan options
    debug = false
  }

  cflags = [
    "-fdata-sections",
    "-ffunction-sections",
    "-fno-asynchronous-unwind-tables",
    "-fno-unwind-tables",
    "-Os",
    "-fno-exceptions",
    "-fno-rtti",
    "-flto",
  ]

  ldflags = [
    "-flto",
    "-Wl,--gc-sections",
  ]
}

generate_static_abc("nearlinkSsapTaihe_abc") {
  base_url = "$taihe_generated_file_path_ssap"
  files = [ "$taihe_generated_file_path_ssap/@ohos.nearlink.ssap.ets" ]
  is_boot_abc = "True"
  device_dst_file = "/system/framework/nearlinkSsapTaihe_abc.abc"
  dependencies = [ ":run_taihe" ]
}
ohos_prebuilt_etc("nearlinkSsap_etc") {
  source = "$target_out_dir/nearlinkSsapTaihe_abc.abc"
  module_install_dir = "framework"
  part_name = "$part_name"
  subsystem_name = "$subsystem_name"
  deps = [ ":nearlinkSsapTaihe_abc" ]
}

group("nearlinkSsap_taihe") {
  deps = [
    ":nearlinkSsap_etc",
    ":nearlinkSsapTaihe_native"
  ]
}