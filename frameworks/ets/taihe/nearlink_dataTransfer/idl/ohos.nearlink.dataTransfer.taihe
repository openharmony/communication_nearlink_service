from ohos.nearlink.constant use ConnectionState;

@!namespace("@ohos.nearlink.dataTransfer", "dataTransfer")
@!sts_inject("""
static { loadLibrary("nearlinkDataTransferTaihe_native.z") }
""")

function CreatePort(uuid: String): void;
function DestroyPort(uuid: String): void;

@promise function Connect(params: ConnectionParams): void;
@promise function Disconnect(params: ConnectionParams): void;
@promise function WriteData(params: DataParams): void;

function OnConnectionStateChanged(callback: (data: ConnectionResult) => void): void;
function OffConnectionStateChanged(callback: Optional<(data: ConnectionResult) => void>): void;
function OnReadData(callback: (data: DataParams) => void): void;
function OffReadData(callback: Optional<(data: DataParams) => void>): void;
function GetConnectionState(params: ConnectionStateParams): ConnectionState;

struct ConnectionParams {
    address: String;
    uuid: String;
    transferMode: Optional<TransferMode>;
}

struct DataParams {
    address: String;
    uuid: String;
    data: @arraybuffer Array<u8>;
}

struct ConnectionResult {
    address: String;
    uuid: String;
    mtu: i32;
    state: ConnectionState;
}

struct ConnectionStateParams {
    address: String;
    uuid: String;
}

enum TransferMode: i32 {
    BASIC = 0,
    RELIABLE = 1
}